# Copy to .env and fill in. Consumer configs reference these variable NAMES,
# never the values themselves.

# Destination
WAREHOUSE_DSN=postgresql://elt:elt@localhost:5432/warehouse

# abc_salesforce_extract_and_load (OAuth2 client-credentials flow)
ABC_SF_CLIENT_ID=
ABC_SF_CLIENT_SECRET=

# acme_netsuite_extract_and_load (Token-Based Authentication)
ACME_NS_ACCOUNT_ID=
ACME_NS_CONSUMER_KEY=
ACME_NS_CONSUMER_SECRET=
ACME_NS_TOKEN_ID=
ACME_NS_TOKEN_SECRET=

# Mock APIs (demo credentials; see `uv run elt-mock --help`)
GLOBEX_SHOPFRONT_CLIENT_ID=globex-demo
GLOBEX_SHOPFRONT_CLIENT_SECRET=globex-demo-secret
INITECH_TICKETDESK_API_KEY=initech-demo-key
UMBRELLA_CARTWHEEL_USERNAME=umbrella-demo
UMBRELLA_CARTWHEEL_PASSWORD=umbrella-demo-password
HOOLI_HELPLINE_KEY_ID=hooli-demo
HOOLI_HELPLINE_SECRET=hooli-demo-signing-secret
VANDELAY_NS_ACCOUNT_ID=VANDELAY_SB1
VANDELAY_NS_CONSUMER_KEY=vandelay-demo-consumer-key
VANDELAY_NS_CONSUMER_SECRET=vandelay-demo-consumer-secret
VANDELAY_NS_TOKEN_ID=vandelay-demo-token-id
VANDELAY_NS_TOKEN_SECRET=vandelay-demo-token-secret
