# Copy to .env and fill in. Consumer configs reference these variable NAMES,
# never the values themselves.

# Destination
WAREHOUSE_DSN=postgresql://elt:elt@localhost:5432/warehouse

# abc_salesforce_extract_and_load (OAuth2 client-credentials flow)
ABC_SF_CLIENT_ID=
ABC_SF_CLIENT_SECRET=

# acme_netsuite_extract_and_load (Token-Based Authentication)
ACME_NS_ACCOUNT_ID=
ACME_NS_CONSUMER_KEY=
ACME_NS_CONSUMER_SECRET=
ACME_NS_TOKEN_ID=
ACME_NS_TOKEN_SECRET=
