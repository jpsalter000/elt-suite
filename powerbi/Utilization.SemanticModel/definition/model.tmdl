model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

ref table Date
ref table Employee
ref table Client
ref table Project
ref table Item
ref table 'Time Entries'
ref table 'Employee Capacity'
ref table 'Project Margin'
ref table Measures

ref expression Server
ref expression Database
